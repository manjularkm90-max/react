const cluster = require("cluster");
const os = require("os");

if (cluster.isPrimary) {

    const cpu = os.cpus().length;

    for(let i=0;i<cpu;i++){
        cluster.fork();
    }

}else{

    const http = require("http");

    http.createServer((req,res)=>{
        res.end("Worker " + process.pid);
    }).listen(3000);

}
